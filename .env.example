# ---------------------------------------------------------------------------
# Tu Persona Ideal — environment variables
# Copy this file to `.env` and fill in the values. Never commit a real `.env`.
# ---------------------------------------------------------------------------

# GEMINI_API_KEY: Required for real Gemini responses (chat), TTS voice, image
# and story generation. Without it the app runs in an offline graceful-fallback
# mode (canned in-character replies, no voice/images).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The public URL where this app is hosted. Used for self-referential
# links and absolute URLs. Optional in local development.
APP_URL="http://localhost:3000"

# KREA_API_KEY: Optional API key for Krea-2 Turbo text-to-image / text-to-video.
KREA_API_KEY=

# ---------------------------------------------------------------------------
# Server runtime
# ---------------------------------------------------------------------------

# PORT / HOST: where the Express server listens. Defaults: 3000 / 0.0.0.0.
PORT=3000
HOST=0.0.0.0

# NODE_ENV: "development" serves the app through Vite middleware (HMR off);
# "production" serves the prebuilt client from dist/.
NODE_ENV=development

# ---------------------------------------------------------------------------
# Persistence
# ---------------------------------------------------------------------------

# STORAGE_PROVIDER: where server-side state and media are stored.
#   local    -> JSON files under DATA_DIR + media under public/uploads (needs a
#               persistent disk; good for VPS / Docker volumes / Cloud Run + volume)
#   firebase -> Firestore documents + Firebase Storage (stateless, cloud-friendly)
STORAGE_PROVIDER=local

# DATA_DIR: base directory for local JSON state (only used when STORAGE_PROVIDER=local).
DATA_DIR=data

# ---------------------------------------------------------------------------
# Firebase (only required when STORAGE_PROVIDER=firebase)
# ---------------------------------------------------------------------------
# Server-side Firestore/Storage access uses a service account. Provide EITHER a
# path to a service-account JSON file, OR the JSON contents inline.
# GOOGLE_APPLICATION_CREDENTIALS=/secrets/service-account.json
# FIREBASE_SERVICE_ACCOUNT_JSON=
# FIREBASE_PROJECT_ID=nicol-ai
# FIREBASE_STORAGE_BUCKET=nicol-ai.firebasestorage.app
# FIRESTORE_DATABASE_ID=ai-studio-aacf2fdb-046e-4e1a-bc59-9db9cac5660b
